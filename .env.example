# Copy to .env and edit:  cp .env.example .env && nano .env

# Your free DuckDNS hostname (see README step 4).
DOMAIN=yourname-rbi.duckdns.org

# Login password, 12+ characters. Generate one with:  openssl rand -base64 24
RBI_PASSWORD=

# Match your laptop's time zone and language so the remote browser looks consistent.
TZ=America/New_York
BROWSER_LANG=en-US

# Virtual screen size. Use your laptop's browser window size for the sharpest picture.
SCREEN_WIDTH=1600
SCREEN_HEIGHT=900

# Stream tuning: frames per second, and JPEG quality from 2 (best) to 31 (smallest).
FPS=15
JPEG_QUALITY=7

# First page on a brand-new profile, and the search engine used by the address bar.
START_URL=https://duckduckgo.com/
SEARCH_URL=https://duckduckgo.com/?q=

# Chromium's own sandbox: auto (try it, fall back if the host blocks it), on, off.
CHROMIUM_SANDBOX=auto

# Days a login stays valid.
SESSION_DAYS=7
